# =============================================================================
# Exemple de configuration — COPIER vers .env et remplir.
# NE JAMAIS committer le fichier .env (il est dans .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION A (recommandée) — Connexion PostgreSQL directe
# Supabase > Project Settings > Database > Connection string > URI
# Utiliser de préférence un rôle EN LECTURE SEULE.
# Le pooler (port 6543) ou la connexion directe (port 5432) fonctionnent tous deux.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Noms alternatifs également acceptés (première variable non vide utilisée) :
#   SUPABASE_CONNECTION_STRING | SUPABASE_DB_URL | POSTGRES_URL | PG_CONNECTION_STRING
# SUPABASE_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Variante décomposée (utilisée seulement si DATABASE_URL est absente)
# PGHOST=db.xxxxxxxxxxxx.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=
# PGSSLMODE=require

# -----------------------------------------------------------------------------
# OPTION B (repli) — API REST Supabase (PostgREST)
# Supabase > Project Settings > API
# La clé "anon" suffit si les tables sont lisibles ; sinon "service_role"
# (à manipuler avec précaution : elle contourne les RLS).
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Plusieurs noms sont acceptés :
#   anon    : SUPABASE_KEY | SUPABASE_ANON_KEY | SUPABASE_ANON_PUBLIC_KEY | SUPABASE_PUBLISHABLE_KEY
#   service : SUPABASE_SERVICE_ROLE_KEY | SUPABASE_SERVICE_ROLE | SUPABASE_SECRET_KEY
SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE=

# Rôle de clé privilégié : anon (défaut, moindre privilège) | service
# Passer à `service` si les politiques RLS renvoient 0 ligne avec la clé anon.
SUPABASE_KEY_ROLE=anon

# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
# Schéma PostgreSQL contenant les tables du modèle en étoile
DB_SCHEMA=public
# Backend d'accès : auto | postgres | rest
DB_BACKEND=auto
# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
